<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_inner">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="25dp"
        android:paddingBottom="35dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CampusBudget"
            android:textColor="#1565C0"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Expense Manager"
            android:textColor="#6380A0"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>


        <!-- Summary Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/dashboard_card"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/tvDashboardBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Budget: ₹0.00"
                android:textColor="#174A7E"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDashboardSpent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spent: ₹0.00"
                android:textColor="#294E7A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvDashboardRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remaining: ₹0.00"
                android:textColor="#294E7A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

        </LinearLayout>


        <!-- Buttons -->

        <Button
            android:id="@+id/btnBudget"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SET MONTHLY BUDGET"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/dashboard_button"
            android:elevation="4dp"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/btnAddExpense"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ADD EXPENSE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/dashboard_button"
            android:elevation="4dp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="TRANSACTION HISTORY"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/dashboard_button"
            android:elevation="4dp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnAnalysis"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="EXPENSE ANALYSIS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/dashboard_button"
            android:elevation="4dp"
            android:layout_marginTop="12dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your expenses • Stay within your budget"
            android:textColor="#7189A5"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="28dp"/>

    </LinearLayout>

</ScrollView>